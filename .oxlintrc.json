{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "@typeonce/oxlint-plugin-ritmo"
  ],
  "categories": {
    "correctness": "off"
  },
  "overrides": [
    {
      "files": [
        "packages/*/src/**",
        "examples/**",
        "scripts/**"
      ],
      "rules": {
        "ritmo/handle-tick-result": "error",
        "ritmo/prefix-descriptor-and-system-names": "error",
        "ritmo/use-cell-value": "error"
      }
    },
    {
      "files": [
        "packages/*/src/**",
        "examples/*/simulation.ts",
        "examples/*/schema.ts",
        "examples/*/systems/**",
        "examples/genetics/logic.ts",
        "examples/genetics/math.ts"
      ],
      "rules": {
        "ritmo/use-clock-for-time": "error",
        "ritmo/use-random-for-randomness": "error",
        "ritmo/use-ops-for-math": "error",
        "ritmo/keep-simulation-headless": "error",
        "ritmo/no-infinity-in-simulation-data": "error"
      }
    },
    {
      "files": [
        "examples/*/systems/render*.ts"
      ],
      "rules": {
        "ritmo/keep-simulation-headless": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "coverage/**",
    ".agents/**",
    "docs/**",
    "output/**"
  ]
}
