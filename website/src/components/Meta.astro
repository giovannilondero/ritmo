---
// The head tags every page shares: icons, the canonical URL, and the link
// preview (Open Graph and X), so a shared link shows the Ritmo card.
import { brand } from "../brand.ts"

interface Props {
  /** The full tab title, as the link preview shows it. */
  title: string
  description: string
}

const { title, description } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const social = new URL(brand.social.src, Astro.site)
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#0E1013" />
<link rel="icon" type="image/svg+xml" href={brand.favicon.src} />
<link rel="icon" type="image/png" sizes="32x32" href={brand.favicon32.src} />
<link rel="icon" type="image/png" sizes="16x16" href={brand.favicon16.src} />
<link rel="apple-touch-icon" href={brand.appIcon.src} />
<link rel="canonical" href={canonical} />
<link rel="describedby" type="text/plain" href="/llms.txt" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Ritmo" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={social} />
<meta property="og:image:width" content={String(brand.social.width)} />
<meta property="og:image:height" content={String(brand.social.height)} />
<meta property="og:image:alt" content="Ritmo: the agent-first type safe ECS runtime" />
<meta name="twitter:card" content="summary_large_image" />
