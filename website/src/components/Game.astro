---
// A game running inside a page. It is a frame around `/play/<id>/`: each game
// keeps its own window, so its keyboard and gamepad listeners, and any crash,
// stay inside the frame. The frame loads when it nears the screen, and the
// game starts on a click.
import { demos } from "../demos/index.ts"
import type { DemoId } from "../demos/index.ts"

interface Props {
  id: DemoId
  /** Width over height of the frame. */
  ratio?: string
}

const { id, ratio = "11 / 8" } = Astro.props
const demo = demos[id]
const href = `/play/${id}/`
---

<figure class="game">
  <div class="frame" style={`aspect-ratio: ${ratio}`}>
    <iframe src={href} title={`${demo.title}, a game made with Ritmo`} loading="lazy" allow="gamepad; fullscreen"></iframe>
  </div>
  <figcaption>
    <span><strong>{demo.title}</strong> <span class="muted">{demo.controls}</span></span>
    <span class="actions">
      <a href={href} target="_blank" rel="noopener">Full screen</a>
      <a href={demo.source}>Source</a>
    </span>
  </figcaption>
</figure>

<style>
  .game {
    margin: 0 0 1.6em;
  }

  .frame {
    position: relative;
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--ink);
  }

  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    padding-top: 10px;
    font-size: 0.85rem;
  }

  strong {
    font-family: var(--mono);
    font-weight: 600;
  }

  .actions {
    display: flex;
    gap: 16px;
    font-family: var(--mono);
    font-size: 0.82rem;
  }
</style>
